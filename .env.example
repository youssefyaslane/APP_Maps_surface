# Modèle du fichier .env — à copier en .env puis à compléter :
#   cp .env.example .env
# Le vrai .env est exclu de Git (.gitignore) : c'est là, et seulement là, que
# vont les mots de passe. Ce modèle-ci est versionné et ne doit jamais en
# contenir.
#
# docker-compose.yml lit ces valeurs au démarrage ; s'il en manque une, il
# refuse de démarrer et dit laquelle.

# Serveur PostgreSQL qui héberge la base de l'application
SOLAR_DB_HOST=
SOLAR_DB_PORT=5432
SOLAR_DB_NAME=

# Schéma qui porte les tables (companies, ia_segments, users…). Entre
# guillemets s'il contient un espace.
SOLAR_DB_SCHEMA="solar intelligence"

SOLAR_DB_USER=
SOLAR_DB_PASSWORD=

# Clé de chiffrement des mots de passe enregistrés depuis la page
# Administration → Base de données. Facultative : sans elle, la page affiche
# la base active mais refuse d'en enregistrer d'autres. À générer une fois :
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Ne la changez plus ensuite : les mots de passe déjà enregistrés deviendraient
# illisibles, et il faudrait les ressaisir.
DB_CONFIG_KEY=
